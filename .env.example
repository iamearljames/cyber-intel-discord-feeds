# Copy to .env (gitignored) and fill in your own webhook URLs. Docker
# Compose passes this file to the container.
# Never commit .env or paste these URLs anywhere: anyone holding one can post.

WEBHOOK_NEWS=
WEBHOOK_VULNS=
WEBHOOK_ADVISORIES=
WEBHOOK_RESEARCH=
WEBHOOK_RANSOM=

# Optional: source health alerts (a source failing for 24 hours, and its recovery)
WEBHOOK_OPS=

# Optional: NVD API key (free from nvd.nist.gov); raises the NVD rate limit
NVD_API_KEY=

# ransomware.live PRO API key (free at ransomware.live/my); needed by the
# ransomware source. Keep it as secret as the webhook URLs.
RANSOMWARE_LIVE_API=

# Optional: a URL or email for feed operators to reach you, sent in the
# User-Agent as "intel-feeds/<version> (+<contact>)". Some feeds and APIs ask
# automated clients for one. Leave empty to send none.
INTEL_FEEDS_CONTACT=

# Set by the Docker image and compose.yaml; change them there. Outside Docker:
# INTEL_FEEDS_INTERVAL keeps the bot running (15m, 1h; unset = run once), and
# INTEL_FEEDS_STATE is the state file (default state.json). See
# docs/configuration.md.
# INTEL_FEEDS_INTERVAL=15m
# INTEL_FEEDS_STATE=state.json
